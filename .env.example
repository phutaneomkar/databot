# Binance Spot Testnet Credentials (Get them for free from https://testnet.binance.vision/)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Trading Pair & Position Size
SYMBOL=BTCUSDT
TRADE_QUANTITY=0.001

# Strategy Settings
TIMEFRAME=1m
FAST_MA_PERIOD=7
SLOW_MA_PERIOD=25
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=68

# Risk Management
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0

# Execution Mode: Set to 'true' to simulate without placing orders, or 'false' for live testnet execution
DRY_RUN=false
POLL_INTERVAL_SECONDS=15

